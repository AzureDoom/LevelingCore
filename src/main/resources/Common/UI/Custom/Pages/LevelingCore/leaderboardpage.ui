$C = "../../Common.ui";

@HeaderTitleStyle = LabelStyle(
    FontSize: 15,
    RenderUppercase: true,
    RenderBold: true,
    VerticalAlignment: Center,
    TextColor: #b4c8c9,
    FontName: "Default",
    LetterSpacing: 0.5
);

@NavButtonLabelStyle = LabelStyle(
    FontSize: 16,
    TextColor: #ffffff,
    RenderBold: true,
    HorizontalAlignment: Center,
    VerticalAlignment: Center
);

@NavButtonStyle = TextButtonStyle(
    Default: (
        Background: PatchStyle(TexturePath: "../../Common/Buttons/Primary_Square.png"),
        LabelStyle: @NavButtonLabelStyle
    ),
    Hovered: (
        Background: PatchStyle(TexturePath: "../../Common/Buttons/Primary_Square_Pressed.png"),
        LabelStyle: @NavButtonLabelStyle
    ),
    Pressed: (
        Background: PatchStyle(TexturePath: "../../Common/Buttons/Primary_Square_Pressed.png"),
        LabelStyle: @NavButtonLabelStyle
    ),
    Disabled: (
        Background: PatchStyle(TexturePath: "../../Common/Buttons/Primary_Square.png"),
        LabelStyle: @NavButtonLabelStyle
    )
);

@NavButton = TextButton {
    Style: @NavButtonStyle;
    Anchor: (Width: 110, Height: 34);
};

$C.@PageOverlay {
    $C.@DecoratedContainer {
        Anchor: (Width: 700, Height: 650);
        Padding: (Full: 0);
        Background: #737d85;

        #Title {
            Group {
                LayoutMode: Left;
                Group { FlexWeight: 1; }
                Label #LeaderboardTitle {
                    Style: @HeaderTitleStyle;
                    Text: "Leaderboard";
                }
                Group { FlexWeight: 1; }
            }
        }

        #Content {
            LayoutMode: Top;
            Padding: (Full: 10);

            Group {
                LayoutMode: Left;
                Anchor: (Width: 660, Height: 40);

                @NavButton #PrevButton { Text: "Prev"; }
                Group { Anchor: (Width: 12); }
                @NavButton #RefreshButton { Text: "Refresh"; }
                Group { FlexWeight: 1; }

                Label #YourRankLabel {
                    Style: (
                        FontSize: 15,
                        TextColor: #9fe3ff,
                        RenderBold: true,
                        VerticalAlignment: Center
                    );
                    Text: "Your Rank: Unranked";
                }
                Group { FlexWeight: 1; }

                Label #PageLabel {
                    Style: (
                        FontSize: 15,
                        TextColor: #FFD700,
                        RenderBold: true,
                        VerticalAlignment: Center
                    );
                    Text: "Showing 1 - 0";
                }

                Group { Anchor: (Width: 12); }
                @NavButton #NextButton { Text: "Next"; }
            }

            Group {
                Anchor: (Height: 8);
            }

            Group #LeaderboardRows {
                FlexWeight: 1;
                LayoutMode: TopScrolling;
                Padding: (Left: 4, Right: 12, Top: 4, Bottom: 4);
                ScrollbarStyle: $C.@DefaultScrollbarStyle;

                Group {
                    LayoutMode: Top;

                    Group #Row1 {
                        Anchor: (Width: 650, Height: 52, Bottom: 4);
                        LayoutMode: Left;
                        Background: #1e2d3d(0.65);
                        Padding: (Left: 12, Right: 12, Top: 10, Bottom: 10);
                        Label #Rank1 { Style: (FontSize: 16, TextColor: #FFD700, RenderBold: true); Anchor: (Width: 60); Text: "#1"; }
                        Label #Name1 { Style: (FontSize: 16, TextColor: #ffffff, RenderBold: true); Anchor: (Width: 250); Text: "Player"; }
                        Group { FlexWeight: 1; }
                        Label #Level1 { Style: (FontSize: 16, TextColor: #9fe3ff, RenderBold: true); Anchor: (Width: 110); Text: "Lv. 1"; }
                        Label #Xp1 { Style: (FontSize: 15, TextColor: #cccccc, RenderBold: false); Anchor: (Width: 160); Text: "XP: 0"; }
                    }

                    Group #Row2  { Anchor: (Width: 650, Height: 52, Bottom: 4); LayoutMode: Left; Background: #1e2d3d(0.65); Padding: (Left: 12, Right: 12, Top: 10, Bottom: 10); Label #Rank2  { Style: (FontSize: 16, TextColor: #FFD700, RenderBold: true); Anchor: (Width: 60); Text: "#2"; } Label #Name2  { Style: (FontSize: 16, TextColor: #ffffff, RenderBold: true); Anchor: (Width: 250); Text: "Player"; } Group { FlexWeight: 1; } Label #Level2  { Style: (FontSize: 16, TextColor: #9fe3ff, RenderBold: true); Anchor: (Width: 110); Text: "Lv. 1"; } Label #Xp2  { Style: (FontSize: 15, TextColor: #cccccc); Anchor: (Width: 160); Text: "XP: 0"; } }
                    Group #Row3  { Anchor: (Width: 650, Height: 52, Bottom: 4); LayoutMode: Left; Background: #1e2d3d(0.65); Padding: (Left: 12, Right: 12, Top: 10, Bottom: 10); Label #Rank3  { Style: (FontSize: 16, TextColor: #FFD700, RenderBold: true); Anchor: (Width: 60); Text: "#3"; } Label #Name3  { Style: (FontSize: 16, TextColor: #ffffff, RenderBold: true); Anchor: (Width: 250); Text: "Player"; } Group { FlexWeight: 1; } Label #Level3  { Style: (FontSize: 16, TextColor: #9fe3ff, RenderBold: true); Anchor: (Width: 110); Text: "Lv. 1"; } Label #Xp3  { Style: (FontSize: 15, TextColor: #cccccc); Anchor: (Width: 160); Text: "XP: 0"; } }
